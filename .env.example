# Copy to .env (gitignored — real values never get committed) and edit.
# Loaded automatically by main.py via python-dotenv. Real environment
# variables (e.g. set by systemd's EnvironmentFile=) always take priority
# over this file.

# Comma-separated list of browser origins allowed to call this API.
# Must be the exact origin your frontend is served from, including scheme —
# e.g. your Vercel deployment's URL. No trailing slash.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Usually left at the defaults below: uvicorn binds 127.0.0.1:8000 and your
# reverse proxy (Netbird, Caddy, nginx, ...) forwards to it — the backend
# itself is never exposed to the internet directly.
# HOST=127.0.0.1
# PORT=8000
# RELOAD=false
