[Unit]
Description=StegoArt backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=stegoart
# The folder CONTAINING your backend/ clone (so `python -m backend.main`
# resolves `backend` as a package) — e.g. if you cloned to
# /opt/stegoart/backend, WorkingDirectory is /opt/stegoart.
WorkingDirectory=/opt/stegoart
# No Environment=/EnvironmentFile= needed here: main.py loads
# /opt/stegoart/backend/.env itself via python-dotenv on startup.
# Copy backend/.env.example to backend/.env on the server and edit it.
ExecStart=/opt/stegoart/.venv/bin/python -m backend.main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
