[Unit]
Description=StegoArt backend (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=stegoart
# This repo's OWN root (flat layout — main.py imports absolutely against
# its own directory), e.g. if you cloned to /opt/stegoart/backend:
WorkingDirectory=/opt/stegoart/backend
# No Environment=/EnvironmentFile= needed here: main.py loads
# /opt/stegoart/backend/.env itself via python-dotenv on startup.
# Copy backend/.env.example to backend/.env on the server and edit it.
ExecStart=/opt/stegoart/.venv/bin/python main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
